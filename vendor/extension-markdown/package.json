{
  "name": "@sveltekit-i18n/extension-markdown",
  "version": "3.0.0-next.0",
  "description": "Renders Markdown in translated messages as Svelte components, for @sveltekit-i18n/base.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
