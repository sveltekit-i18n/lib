  "funding": "https://github.com/sponsors/sveltekit-i18n",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "character-entities": "^2.0.2"
  },
  "peerDependencies": {
    "@sveltekit-i18n/base": "^3.0.0 || ^3.1.0-next.0",
    "svelte": ">=5"
  },
  "svelte": "./dist/index.js"
