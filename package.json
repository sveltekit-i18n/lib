{
  "name": "sveltekit-i18n",
  "version": "3.0.0",
  "description": "Internationalization library for SvelteKit",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "svelte": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run build && pnpm run typecheck",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint --fix .",
    "prepare": "simple-git-hooks"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sveltekit-i18n/lib.git"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation"
  ],
  "author": "Jarda Svoboda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sveltekit-i18n/lib/issues"
  },
  "homepage": "https://sveltekit-i18n.github.io",
  "funding": "https://github.com/sponsors/sveltekit-i18n",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2",
    "deno": ">=2"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sveltekit-i18n/base": "3.0.0",
    "@sveltekit-i18n/parser-curly": "3.1.0"
  },
  "svelte": "./dist/index.js",
  "simple-git-hooks": {
    "pre-commit": "pnpm -r --include-workspace-root run lint"
  }
}
