<script>
  import { NAMESPACES, get } from '#lib/translations/index.js';

  // Exactly what a .svelte page would do — by the time this runs, mdsvex has
  // already turned the file into an ordinary Svelte component.
  const i18n = get();

  // The shell strings sit in `config.translations` under their own flat keys;
  // only the configured namespaces were actually loaded.
  const loaded = $derived(NAMESPACES
    .map(({ namespace }) => namespace)
    .filter((namespace) => Object.hasOwn(i18n.rawTranslations[i18n.locale] ?? {}, namespace))
    .join(', '));
</script>

<span class="badge">{i18n.t('guide.badge')}</span>

# {i18n.t('guide.heading')}

{i18n.t('guide.intro')}

## {i18n.t('guide.step', { n: 1 })} — {i18n.t('guide.install')}

```bash
npm install sveltekit-i18n
```

## {i18n.t('guide.step', { n: 2 })} — {i18n.t('guide.configure')}

```javascript
export const config = {
  translations: { en: { hello: 'Hello' } },
};
```

## {i18n.t('guide.step', { n: 3 })} — {i18n.t('guide.render')}

```svelte
<h1>{i18n.t('hello')}</h1>
```

<p class="note"><strong>{i18n.t('guide.loaded')}:</strong> <code>{loaded}</code></p>
